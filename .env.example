# Copy this file to `src-tauri/.env` and fill in real values before
# producing a release build. The build script (src-tauri/build.rs) reads
# these and re-exports them as `cargo:rustc-env=...` so the Rust source
# can pick them up via env!() at compile time. They are then wrapped in
# `cryptify::encrypt_string!()` so the plaintext never appears in the
# final binary.
#
# In `cargo build` (debug) these may be empty — the project will compile
# and run, but license validation will reject every key. In a release
# build (`cargo tauri build`) build.rs will fail loudly if any of the
# AUTHFORGE_* values are empty.

# AuthForge SDK credentials (https://authforge.dev — see README)
AUTHFORGE_APP_ID=
AUTHFORGE_APP_SECRET=
AUTHFORGE_PUBLIC_KEY=

# Stripe checkout URLs shown on the License tab "Buy" buttons
STRIPE_MONTHLY_URL=
STRIPE_LIFETIME_URL=
